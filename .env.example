# =====================================================================
# SmartBot AI – environment variables
# =====================================================================
# Copy this file to `.env` and fill in real values.
# Only the items marked "required" are needed to boot the dev server.

# --- Postgres (required) ---------------------------------------------
# Easiest: run a local DB with Docker:
#   docker run -d --name smartbot-pg -e POSTGRES_PASSWORD=postgres \
#     -p 5432:5432 postgres:16
# Then use the two lines below. Both vars point at the same DB; Prisma
# uses PRISMA_URL for the pooled connection and DIRECT_URL for
# migrations.
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/smartbot?schema=public"
POSTGRES_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smartbot?schema=public"

# --- NextAuth (required) ---------------------------------------------
# Generate one at https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=replace-me-with-a-32-char-random-string
NEXTAUTH_URL=http://localhost:3000

# --- OAuth providers (optional; only if you want to sign in locally) -
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OpenAI (optional at boot, required to chat / ingest) ------------
# When a user is signed in they can provide their own key in Settings,
# which takes precedence over this one.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vercel Blob (optional; needed for PDF uploads) ------------------
BLOB_READ_WRITE_TOKEN=

# --- Stripe (optional; billing) --------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_HOBBY_PRICE_ID=
NEXT_PUBLIC_STRIPE_BASIC_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=

# --- Email (optional; welcome + inquiry emails) ----------------------
RESEND_TOKEN=

# --- Misc analytics/telemetry (optional) -----------------------------
GOOGLE_ANALYTICS_ID=
GITHUB_ACCESS_TOKEN=
TINYBIRD_TOKEN=
